{
  "name": "firelight-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "validate:lessons": "node scripts/validate-lessons.mjs",
    "verify:arduino": "node scripts/compile-lessons.mjs",
    "prebuild": "npm run validate:lessons",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:unit && npm run test:worker && npm run test:compiler",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:worker": "npm run build",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:compiler": "python3 -m unittest discover -s compiler-service/tests -p 'test_*.py'",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning",
    "db:test": "supabase test db",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "check": "npm run cf-typegen:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "check:startup": "wrangler check startup",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "hono": "^4.13.0",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.111.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
